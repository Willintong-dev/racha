# Copia este archivo como .env.local y llena los valores de tu proyecto Supabase
# (supabase.com → tu proyecto → Project Settings → API).
# Si los dejas vacíos, la app funciona en "modo local": las cuentas de usuario y los datos
# viven solo en este navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
